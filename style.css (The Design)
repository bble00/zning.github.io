css
body {
    font-family: Arial, sans-serif;
    background-color: #f4f4f9;
    color: #333;
    text-align: center;
    padding: 50px;
}

header {
    background-color: #24292e;
    color: white;
    padding: 20px;
    border-radius: 8px;
}

button {
    background-color: #2ea44f;
    color: white;
    border: none;
    padding: 10px 20px;
    font-size: 16px;
    border-radius: 5px;
    cursor: pointer;
}

button:hover {
    background-color: #2c974b;
}